{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-typedoku",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-22",
  // Workers Free: no cron triggers (the account-wide limit of five is used), no custom CPU limit, no Durable Objects, no containers.
  // typedoku.jevplay.games is canonical. The pre-rename host stays attached until the orchestrator's 301 redirect replaces it.
  "routes": [{ "pattern": "typedoku.jevplay.games", "custom_domain": true }, { "pattern": "sudoku.jevplay.games", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/"] },
  // The D1 database keeps its pre-rename name (owner decision 2026-10-14): D1 cannot be renamed in place.
  "d1_databases": [{ "binding": "DB", "database_name": "jev-sudoku", "database_id": "846ce4fe-69d3-4a59-8dc3-5e41897a9553", "migrations_dir": "migrations" }],
  // Secrets are set with `wrangler secret put` and never live here: TYPESAFE_API_KEY, LAUNCH_SIGNING_KEY, DISCORD_CLIENT_SECRET,
  // ADMIN_ANALYTICS_TOKEN. DISCORD_CLIENT_ID, DISCORD_PUBLIC_KEY and ADMIN_DISCORD_IDS are not secret; set them as secrets or add them here.
  "vars": {
    "APP_ORIGIN": "https://typedoku.jevplay.games",
    "LEGACY_APP_ORIGINS": "https://sudoku.jevplay.games",
    "JEV_MODEL": "jev-1.13.0",
    "PRACTICE_PACING_MS": "8000",
    "MAX_ACTIVE_MATCHES": "20",
    "MAX_JEV_CALLS_PER_DAY": "5000",
    "JEV_CALLS_PER_HOUR": "600",
    "MAX_JEV_REQUESTS_PER_MATCH": "600",
    "ABANDONED_AFTER_MS": "600000",
    "TELEMETRY_RETENTION_DAYS": "30",
    "OPERATIONS_RETENTION_DAYS": "30"
  },
  "observability": { "enabled": false }
}
