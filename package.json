{
  "name": "jev-sudoku-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent-board Sudoku races with structured JEV decisions and auditable analytics, on Cloudflare Workers + D1.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node --env-file-if-exists=.env local/server.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:browser": "python scripts/browser_smoke.py",
    "test:maintenance": "node scripts/maintenance-smoke.js",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.js",
    "bench:requests": "node scripts/bench-requests.js",
    "puzzles": "node --env-file-if-exists=.env scripts/puzzles.js",
    "pool:build": "node scripts/build-pool.js",
    "golden:candidates": "node scripts/golden-candidates.js",
    "analytics": "node --env-file-if-exists=.env scripts/analytics.js",
    "maintenance": "node --env-file-if-exists=.env scripts/maintenance.js",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.js",
    "deploy": "npx --yes wrangler@4.35.0 deploy",
    "db:remote": "npx --yes wrangler@4.35.0 d1 migrations apply jev-sudoku --remote",
    "db:local": "npx --yes wrangler@4.35.0 d1 migrations apply jev-sudoku --local"
  }
}
