# Local development (`npm start`) runs the same Worker Cloudflare runs, behind a small Node adapter with node:sqlite standing in for D1.
# Local practice works with no credentials and no npm installation. Never commit .env.
# On Cloudflare these names are Worker vars/secrets instead (see docs/DEPLOYMENT.md); .env is not read there.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Optional: local database file (default .data/sudoku.sqlite).
DATABASE_PATH=

# Required when APP_ORIGIN is a public https origin (production); local development generates an ephemeral one.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LAUNCH_SIGNING_KEY=

# Live TypeSafe JEV. Empty key = the opponent is the labeled local heuristic and every game is practice.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
# Provider-call quota reservations kept in D1 (0 = no provider calls allowed). Each attempt, including a retry, reserves one call.
MAX_JEV_CALLS_PER_DAY=5000
JEV_CALLS_PER_HOUR=600
MAX_JEV_REQUESTS_PER_MATCH=600
# Optional manually supplied price snapshot for ESTIMATES, never billing claims.
# Leave BOTH empty for unknown cost. Output can explicitly be set to 0.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=

# Discord application credentials. Never put these into public/game.js.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Optional development-guild command registration for `npm run discord:register`; omit for global registration.
DISCORD_TEST_GUILD_ID=

# Browser operator dashboard: comma-separated Discord user IDs.
ADMIN_DISCORD_IDS=
# Optional API-only operator bearer token. Do not store it in browser localStorage.
ADMIN_ANALYTICS_TOKEN=

MAX_ACTIVE_MATCHES=20
MAX_MATCH_EVENTS=12000
PRACTICE_PACING_MS=8000
# A running attempt nobody has touched for this long is voided (there is no process to keep it alive). 60000..3600000.
ABANDONED_AFTER_MS=600000
# Raw optional browser observations and HTTP/security operational logs; purged lazily by the sweep.
TELEMETRY_RETENTION_DAYS=30
OPERATIONS_RETENTION_DAYS=30
