# Local practice works with no credentials and no npm installation.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=data/arcade.sqlite
# Docker Compose only: your public hostname, without https://.
GAME_DOMAIN=
# Optional: cap the SIGTERM drain (ms). Unset keeps waiting for active games. Use e.g. 25000 on hosts that kill slow restarts.
SHUTDOWN_GRACE_MS=

# Production: use NODE_ENV=production, an HTTPS APP_ORIGIN and a stable random key.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LAUNCH_SIGNING_KEY=

# Live TypeSafe JEV. Empty key => explicitly labeled heuristic-only practice.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=2000
MAX_OUTBOUND_JEV_REQUESTS=8
MAX_JEV_REQUESTS_PER_MATCH=600
# Optional manually supplied price snapshot for ESTIMATES, never billing claims.
# Leave BOTH empty for unknown cost. Output can explicitly be set to 0.
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=

# Discord application credentials. Never put these into public/game.js.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Optional development-guild command registration; omit for global registration.
DISCORD_TEST_GUILD_ID=

# Browser operator dashboard: comma-separated Discord user IDs.
ADMIN_DISCORD_IDS=
# Optional API-only operator bearer token. Do not store it in browser localStorage.
ADMIN_ANALYTICS_TOKEN=

MAX_ACTIVE_MATCHES=20
MAX_MATCH_EVENTS=12000
PRACTICE_PACING_MS=8000
# Raw optional browser observations and HTTP/security operational logs.
TELEMETRY_RETENTION_DAYS=30
OPERATIONS_RETENTION_DAYS=30
